{% extends "base.html" %}
{% block title %}Skill Profile — Proficiency Tracking & Gap Indicators{% endblock %}

{% block content %}
<div class="section-header">
    <span class="hero-tag" style="background:rgba(6,182,212,0.12); border-color:var(--cyan); color:var(--cyan-light);">INTERACTIVE SKILL MATRIX</span>
    <h1 class="section-title">⚡ Skill Profile & Skill-Gap Analyzer</h1>
    <p class="section-desc">Track your technical proficiencies in real-time and identify missing skill gaps for target industry roles.</p>
</div>

<!-- TOP ANALYZER BAR -->
<div class="card-panel" style="border-color:var(--border-glow);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div style="flex:1; min-width:260px;">
            <label style="font-size:14px; font-weight:700; color:white; margin-bottom:8px;">🎯 Target Role for Skill Gap Analysis:</label>
            <select id="role_analyzer_select" style="font-size:15px; font-weight:600; background:var(--bg-dark); padding:12px 16px;">
                <option value="Web Developer">💻 Web Developer (Full-Stack)</option>
                <option value="AI/ML Engineer">🤖 AI/ML Engineer</option>
                <option value="Data Analyst">📊 Data Analyst / Data Scientist</option>
                <option value="Software Engineer">⚙️ Software Engineer (Backend/DSA)</option>
                <option value="Cloud & DevOps Engineer">☁️ Cloud & DevOps Engineer</option>
                <option value="Mobile App Developer">📱 Mobile App Developer</option>
            </select>
        </div>
        <div style="text-align:right;">
            <span style="font-size:13px; color:var(--text-muted);">Match Percentage:</span>
            <div id="gap_match_score" style="font-size:36px; font-weight:800; color:var(--emerald-light); font-family:'Outfit',sans-serif; line-height:1;">
                0%
            </div>
        </div>
    </div>

    <!-- MATCH PROGRESS FILL -->
    <div class="progress-track" style="height:16px; margin:16px 0 24px;">
        <div id="gap_progress_fill" class="progress-fill" style="width:0%;">0%</div>
    </div>

    <!-- GAP MATRIX COLUMNS -->
    <div class="gap-indicator-box">
        <!-- MATCHED SKILLS -->
        <div class="gap-column" style="border-color:rgba(16,185,129,0.3);">
            <h4 style="color:var(--emerald-light);">
                <span>✓</span> Acquired Skills Matched
            </h4>
            <div id="gap_matched_container" class="tag-list">
                <!-- Populated via app.js -->
            </div>
        </div>

        <!-- MISSING / GAP SKILLS -->
        <div class="gap-column" style="border-color:rgba(244,63,94,0.3);">
            <h4 style="color:#FDA4AF;">
                <span>⚠️</span> Missing Skill Gaps (Required)
            </h4>
            <div id="gap_missing_container" class="tag-list">
                <!-- Populated via app.js -->
            </div>
        </div>
    </div>
</div>

<!-- ADD NEW SKILL FORM -->
<div class="card-panel">
    <h3 style="font-size:18px; font-weight:700; color:white; margin-bottom:16px;">➕ Add Skill & Set Proficiency</h3>
    <form method="POST" action="{{ url_for('skills') }}" class="form-row">
        <div style="flex:2;">
            <label>Skill Name (e.g. React, Python, Docker, SQL, Communication)</label>
            <input type="text" name="skill_name" placeholder="Enter skill..." required>
        </div>
        <div style="flex:1;">
            <label>Proficiency Level</label>
            <select name="proficiency" required>
                <option value="Beginner (25%)">Beginner (25%)</option>
                <option value="Intermediate (50%)" selected>Intermediate (50%)</option>
                <option value="Advanced (75%)">Advanced (75%)</option>
                <option value="Expert (90%+) ">Expert (90%+)</option>
            </select>
        </div>
        <div style="flex:0.8;">
            <button type="submit" class="btn-primary" style="width:100%; justify-content:center;">Save Skill</button>
        </div>
    </form>
</div>

<!-- ACQUIRED SKILLS LIST -->
<div class="card-panel">
    <div class="card-title-bar">
        <h2>⚡ Your Skill Portfolio ({{ skills|length }})</h2>
    </div>

    {% if skills %}
        <div class="skill-grid">
            {% for s in skills %}
                <div class="skill-card-item">
                    <div class="skill-card-header">
                        <span class="skill-name user-skill-tag" data-skill-name="{{ s['skill_name'] }}">{{ s['skill_name'] }}</span>
                        {% set lvl = s['proficiency']|lower %}
                        <span class="skill-level-badge {% if 'expert' in lvl %}level-expert{% elif 'advanced' in lvl %}level-advanced{% elif 'intermediate' in lvl %}level-intermediate{% else %}level-beginner{% endif %}">
                            {{ s['proficiency'] }}
                        </span>
                    </div>

                    <!-- PROGRESS BAR FOR PROFICIENCY -->
                    <div class="progress-track" style="height:8px; margin:8px 0 14px;">
                        {% set pct = 50 %}
                        {% if '25' in s['proficiency'] or 'beginner' in lvl %}{% set pct = 25 %}
                        {% elif '50' in s['proficiency'] or 'intermediate' in lvl %}{% set pct = 50 %}
                        {% elif '75' in s['proficiency'] or 'advanced' in lvl %}{% set pct = 75 %}
                        {% elif '90' in s['proficiency'] or 'expert' in lvl %}{% set pct = 95 %}{% endif %}
                        <div class="progress-fill" style="width:{{ pct }}%;"></div>
                    </div>

                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:12px; color:var(--text-muted);">Verified Proficiency</span>
                        <a href="{{ url_for('delete_skill', skill_id=s['id']) }}" class="btn-danger btn-sm" style="text-decoration:none;" onclick="return confirm('Remove this skill?')">Delete</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p style="color:var(--text-muted); text-align:center; padding:24px;">
            No skills added yet. Use the form above to build your technical profile.
        </p>
    {% endif %}
</div>
{% endblock %}
